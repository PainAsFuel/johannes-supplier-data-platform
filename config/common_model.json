{
  "_comment": "Canonical product data model. Every supplier feed is normalized into THIS shape. Adding supplier #51 means writing one mapping file, not changing the pipeline.",
  "fields": {
    "sku":          { "type": "string",  "required": true,  "description": "Unique stock keeping unit (our internal key)" },
    "gtin":         { "type": "string",  "required": false, "description": "Global Trade Item Number / barcode (EAN-13)" },
    "title":        { "type": "string",  "required": true,  "description": "Product title" },
    "brand":        { "type": "string",  "required": false, "description": "Manufacturer / brand" },
    "category":     { "type": "string",  "required": false, "description": "Normalized internal category" },
    "price_eur":    { "type": "number",  "required": true,  "description": "Net price in EUR (converted from supplier currency)" },
    "stock_qty":    { "type": "integer", "required": true,  "description": "Available quantity" },
    "weight_kg":    { "type": "number",  "required": false, "description": "Weight normalized to kilograms" },
    "image_url":    { "type": "string",  "required": false, "description": "Primary product image (must be https + image extension)" },
    "description":  { "type": "string",  "required": false, "description": "Marketing description" }
  },
  "category_map": {
    "elec": "Electronics", "electronic": "Electronics", "electronics": "Electronics",
    "comp": "Computers", "computers": "Computers", "pc": "Computers",
    "home": "Home & Kitchen", "kitchen": "Home & Kitchen", "household": "Home & Kitchen",
    "toy": "Toys", "toys": "Toys",
    "garden": "Garden", "outdoor": "Garden"
  },
  "fx_to_eur": { "EUR": 1.0, "USD": 0.92, "GBP": 1.17, "CHF": 1.03 }
}
