{
  "supplier_id": "umbrella",
  "supplier_name": "Umbrella Corp (REST API feed)",
  "format": "api",
  "source": "data/incoming/umbrella_api.json",
  "options": { "record_path": "data.items" },
  "field_map": {
    "sku": "id",
    "gtin": "barcode",
    "title": "attributes.name",
    "brand": "attributes.vendor",
    "category": "attributes.group",
    "stock_qty": "inventory.qty",
    "image_url": "media.thumbnail",
    "description": "attributes.copy"
  },
  "price":  { "field": "pricing.amount", "currency_field": "pricing.currency", "currency_default": "CHF" },
  "weight": { "field": "attributes.weight_g", "unit": "g" }
}
